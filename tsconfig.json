{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@utakata-ui/react": ["./packages/react/src/index.ts"],
      "@utakata-ui/react/manifest": [
        "./packages/react/src/metadata/manifest.ts"
      ]
    }
  },
  "include": [
    "packages/cli/src/**/*.ts",
    "packages/docs/**/*.tsx",
    "packages/react/src/**/*.ts",
    "packages/react/src/**/*.tsx",
    "packages/docs/blume.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "playwright.cross-browser.config.ts",
    "playwright.screen-reader.config.ts",
    "tests/screen-reader/**/*.ts",
    "tests/browser/**/*.ts",
    "tests/browser/**/*.tsx",
    "vite.config.ts"
  ]
}
