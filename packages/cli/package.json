{
  "name": "@utakata-ui/cli",
  "version": "0.1.0",
  "description": "Install Utakata UI source components and check declared color accessibility contracts.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "utakata-ui": "bin/utakata-ui.mjs"
  },
  "files": [
    "bin",
    "src/*.mjs",
    "dist",
    "A11Y.md",
    "example.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UtakataKyosui/Utakata-UI.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "test": "pnpm build && pnpm --workspace-root exec vitest run packages/cli/src/a11y/check.test.ts && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5"
  }
}
