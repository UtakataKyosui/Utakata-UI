{
  "name": "@utakata-ui/react",
  "version": "0.1.0",
  "description": "Accessible React components built with Base UI and Lism CSS.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UtakataKyosui/Utakata-UI.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "files": [
    "dist",
    "src/styles/styles.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles/styles.css",
    "./manifest": {
      "types": "./dist/metadata/manifest.d.ts",
      "import": "./dist/metadata/manifest.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "lism-css": "^1.1.0"
  },
  "peerDependencies": {
    "react": ">=18.3.1",
    "react-dom": ">=18.3.1"
  }
}
