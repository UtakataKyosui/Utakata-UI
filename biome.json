{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/dist",
      "!**/.agents",
      "!**/.claude",
      "!**/.blume",
      "!playwright-report",
      "!test-results",
      "!unit-stability-results",
      "!packages/docs/docs/components.md",
      "!packages/docs/docs/components",
      "!packages/docs/docs/en/components",
      "!packages/docs/site/generated"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": { "inputComponents": ["Checkbox", "Switch"] }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    }
  ]
}
