{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/agent-hooks.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Edit|Write|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/agent-hooks.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "utakata-cc-mod": {
      "source": {
        "source": "github",
        "repo": "UtakataKyosui/utakata-cc-mod"
      }
    }
  },
  "enabledPlugins": {
    "goal-orchestrator@utakata-cc-mod": true,
    "task-checkpoint@utakata-cc-mod": true
  }
}
